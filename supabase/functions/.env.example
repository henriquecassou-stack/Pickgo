# Segredos das Edge Functions:  supabase secrets set --env-file supabase/functions/.env
# Sem MP_ACCESS_TOKEN os pagamentos rodam no modo "simulado" (sandbox local).
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MP_WEBHOOK_SECRET=chave-secreta-do-webhook
MP_PAYER_EMAIL=test_user_123456@testuser.com
# Maquininha Point em modo PDV (opcional). Sem ela, cartão usa o Checkout Pro via QR.
MP_POINT_DEVICE_ID=
# PAYMENT_PROVIDER=simulado   # força o modo simulado mesmo com token

# Comprovante e avisos por e-mail (opcional)
RESEND_API_KEY=
EMAIL_FROM=pickgo <comprovante@seudominio.com.br>

# Avisos do administrador
AVISOS_CRON_SECRET=um-segredo-longo-e-aleatorio
APP_URL=https://seu-mercado.vercel.app

APP_ORIGIN=*
