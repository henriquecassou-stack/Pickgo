# --- Frontend (vai para o navegador: só chaves públicas!) ---
# Sem estas duas variáveis o app abre em MODO DEMONSTRAÇÃO (banco local no navegador).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key

# --- Só para scripts locais (scripts/criar-usuarios.mjs). NUNCA prefixe com VITE_ ---
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
